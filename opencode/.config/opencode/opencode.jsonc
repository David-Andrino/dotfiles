{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "enabled_providers": ["ollama", "vLLM", "Strata"],
  "disabled_providers":  ["opencode"],
  "providers": {
    "ollama": {
      "name": "Ollama",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "http://192.168.10.244:11434/v1" },
      "models": {
        "qwen3.8:27b": {
          "name": "qwen3.8-Ollama"
        }
      }
    },
    "vLLM": {
      "name": "vLLM",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "http://192.168.10.244:8000/v1" },
      "models": {
        "RedHatAI/Qwen3.8-27B-INT4": {
          "name": "qwen3.8-vLLM",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 131072, "output": 16384 }
        }
      }
    },
    "Strata": {
      "name": "Strata",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "http://192.168.10.244:8080/v1" },
      "models": {
        "qwen3.8-flash-next-iq3_xxs": {
          "name":"qwen3.8-Strata"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "searxng": {
        "type": "local",
        "command": ["npx", "-y", "mcp-searxng"],
        "environment": { "SEARXNG_URL": "http://192.168.10.11:8080" }
      }
    }
  }
}
