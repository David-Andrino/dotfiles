{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "provider": {
    "ollama": {
      "name": "Ollama",
      "options": {
        "baseURL": "http://192.168.10.244:11434/v1"
      },
      "models": {
        "qwen3.8:27b": {
          "name": "qwen3.8"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "searxng": {
        "type": "local",
        "command": ["npx", "-y", "mcp-searxng"],
        "environment": {
          "SEARXNG_URL": "http://192.168.10.11:8080"
        }
      }
    }
  }
}
