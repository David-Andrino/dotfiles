{
    // Theme & Appearance
    "diff_view_style": "split",
    "cli_default_open_behavior": "new_window",
    "project_panel": {
        "dock": "left",
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "git_panel": {
        "dock": "left",
    },
    "edit_predictions": {
        "copilot": {
            "enable_next_edit_suggestions": true,
        },
        "provider": "copilot",
    },
    "agent_servers": {
        "claude-acp": {
            "type": "registry",
        },
        "gemini": {
            "type": "registry",
        },
    },
    "agent": {
        "profiles": {
            "autopilot": {
                "default_model": {
                    "provider": "copilot_chat",
                    "model": "gpt-5.2",
                    "enable_thinking": true,
                    "effort": "high",
                },
                "name": "Autopilot",
                "tools": {
                    "write_file": true,
                    "update_plan": true,
                    "terminal": true,
                    "spawn_agent": true,
                    "skill": true,
                    "rename_symbol": true,
                    "read_file": true,
                    "move_path": true,
                    "list_directory": true,
                    "grep": true,
                    "go_to_definition": true,
                    "get_code_actions": true,
                    "find_references": true,
                    "find_path": true,
                    "fetch": true,
                    "edit_file": true,
                    "diagnostics": true,
                    "delete_path": true,
                    "create_directory": true,
                    "copy_path": true,
                    "apply_code_action": true,
                },
                "enable_all_context_servers": false,
                "context_servers": {},
            },
        },
        "tool_permissions": {
            "tools": {
                "terminal": {
                    "always_allow": [
                        {
                            "pattern": "^latexmk\\b",
                        },
                        {
                            "pattern": "^tail\\b",
                        },
                        {
                            "pattern": "^grep\\b",
                        },
                        {
                            "pattern": "^head\\b",
                        },
                    ],
                },
            },
        },
        "dock": "right",
        "default_model": {
            "provider": "copilot_chat",
            "model": "gemini-3.1-pro-preview",
            "enable_thinking": true,
            "effort": "high",
        },
        "favorite_models": [],
        "default_profile": "write",
        "model_parameters": [],
    },
    "language_models": {
        "ollama": {
            "api_url": "http://192.168.10.244:11434",
        },
    },
    "ssh_connections": [
        {
            "host": "192.168.10.65",
            "username": "andrinod",
            "args": [],
            "projects": [
                {
                    "paths": ["/home/andrinod"],
                },
                {
                    "paths": ["/home/andrinod/nds/nds-core"],
                },
            ],
        },
        {
            "host": "216",
            "args": [],
            "projects": [
                {
                    "paths": ["/home/andrinod"],
                },
                {
                    "paths": ["/home/andrinod/fit/fit-common"],
                },
                {
                    "paths": ["/home/andrinod/fit/fit-integrated/./"],
                },
            ],
        },
        {
            "host": "54",
            "args": [],
            "projects": [
                {
                    "paths": ["/home/andrinod/fit/fit-common"],
                },
                {
                    "paths": ["/home/andrinod/fit/fit-integrated"],
                },
            ],
        },
        {
            "host": "54ts",
            "args": [],
            "projects": [
                {
                    "paths": ["/home/andrinod/fit/fit-integrated"],
                },
            ],
        },
    ],
    "which_key": {
        "delay_ms": 200,
        "enabled": true,
    },
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "Catppuccin Mocha",
    },
    "icon_theme": {
        "mode": "dark",
        "light": "Zed (Default)",
        "dark": "Zed (Default)",
    },
    "ui_font_size": 16,
    "buffer_font_size": 16,
    "buffer_font_features": { "calt": true },
    "buffer_font_weight": 500,
    "show_wrap_guides": false,
    "cursor_blink": false,
    "cursor_shape": "bar",
    "tab_size": 4,
    "soft_wrap": "prefer_line",
    "preferred_line_length": 120,
    "show_whitespaces": "selection",
    "minimap": { "show": "never" },
    "vertical_scroll_margin": 5,
    "indent_guides": { "enabled": true },
    "inlay_hints": {
        "toggle_on_modifiers_press": {
            "control": true,
            "alt": true,
        },
    },

    // Editor behavior
    "vim_mode": true,
    "use_autoclose": true,
    "ensure_final_newline_on_save": true,
    "remove_trailing_whitespace_on_save": true,
    "format_on_save": "on",
    "linked_edits": true,

    // Vim
    "vim": {
        "cursor_shape": {
            "insert": "bar",
            "normal": "block",
            "visual": "block",
            "replace": "underline",
        },
        "use_system_clipboard": "never",
    },

    // Git
    "git": {
        "git_gutter": "tracked_files",
        "inline_blame": { "enabled": true },
    },

    // Terminal
    "terminal": {
        "font_family": "ZedMono Nerd Font Mono", //"FiraCode Nerd Font Mono",
        "font_size": 16,
        "font_features": { "calt": true },
        "blinking": "terminal_controlled",
    },

    "lsp": {
        "clangd": {
            "binary": {
                "arguments": ["--function-arg-placeholders=0", "--clang-tidy", "--header-insertion=never"],
            },
        },
        "texlab": {
            "settings": {
                "texlab": {
                    "build": {
                        "onSave": true,
                        "forwardSearchAfter": false,
                    },
                },
            },
        },
    },
    "languages": {
        "C": {
            "tab_size": 4,
            "language_servers": ["clangd", "!c-language-server"],
        },
        "C++": {
            "tab_size": 4,
            "language_servers": ["clangd", "!c-language-server"],
        },
        "VHDL": {
            "tab_size": 4,
            "soft_wrap": "none",
        },
        "YAML": {
            "tab_size": 4,
        },
        "LaTeX": {
            "format_on_save": "on",
            "formatter": {
                "external": {
                    "command": "tex-fmt",
                    "arguments": ["--tabsize", "4", "--nowrap", "--stdin"],
                },
            },
        },
    },
}
