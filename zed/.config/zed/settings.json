{
    // Theme & Appearance
    "proxy": "",
    "debugger": {
        "dock": "left",
    },
    "diff_view_style": "split",
    "cli_default_open_behavior": "new_window",
    "project_panel": {
        "dock": "left",
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "button": false,
        "dock": "left",
    },
    "git_panel": {
        "group_by": "none",
        "tree_view": true,
        "dock": "left",
    },
    "edit_predictions": {
        "open_ai_compatible_api": {
            "prompt_format": "qwen",
            "api_url": "",
            "model": "",
        },
        "allow_data_collection": "no",
        "ollama": {
            "model": "qwen3.8:27b",
        },
        "copilot": {
            "enable_next_edit_suggestions": true,
        },
        "provider": "copilot",
    },
    "agent_servers": {
        "claude-acp": {
            "type": "registry",
        },
        "gemini": {
            "default_model": "auto",
            "default_mode": "autoEdit",
            "type": "registry",
        },
    },
    "agent": {
        "profiles": {
            "autopilot": {
                "default_model": {
                    "provider": "copilot_chat",
                    "model": "gpt-5.2",
                    "enable_thinking": true,
                    "effort": "high",
                },
                "name": "Autopilot",
                "tools": {
                    "write_file": true,
                    "update_plan": true,
                    "terminal": true,
                    "spawn_agent": true,
                    "skill": true,
                    "rename_symbol": true,
                    "read_file": true,
                    "move_path": true,
                    "list_directory": true,
                    "grep": true,
                    "go_to_definition": true,
                    "get_code_actions": true,
                    "find_references": true,
                    "find_path": true,
                    "fetch": true,
                    "edit_file": true,
                    "diagnostics": true,
                    "delete_path": true,
                    "create_directory": true,
                    "copy_path": true,
                    "apply_code_action": true,
                },
                "enable_all_context_servers": false,
                "context_servers": {},
            },
        },
        "tool_permissions": {
            "tools": {
                "terminal": {
                    "always_allow": [
                        {
                            "pattern": "^latexmk\\b",
                        },
                        {
                            "pattern": "^tail\\b",
                        },
                        {
                            "pattern": "^grep\\b",
                        },
                        {
                            "pattern": "^head\\b",
                        },
                    ],
                },
            },
        },
        "dock": "right",
        "default_model": {
            "provider": "Strata",
            "model": "qwen3.8-flash-next-iq3_xxs",
            "enable_thinking": false,
        },
        "favorite_models": [
            {
                "provider": "ollama",
                "model": "qwen3.8:27b",
                "enable_thinking": true,
            },
        ],
        "default_profile": "write",
        "model_parameters": [],
    },
